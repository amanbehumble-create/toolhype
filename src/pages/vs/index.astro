---
import Base from '../../layouts/Base.astro'; import Shell from '../../components/Shell.astro';
import { getPairs } from '../../lib/geo'; import { crumbsLd } from '../../lib/ld';
const pairs = getPairs();
const ld = {
  '@context': 'https://schema.org', '@type': 'ItemList', name: 'AI tool comparisons',
  numberOfItems: pairs.length,
  itemListElement: pairs.map((p, i) => ({ '@type': 'ListItem', position: i + 1, name: `${p.a.name} vs ${p.b.name}`, url: `https://toolhype.dev/vs/${p.slug}` })),
};
---
<Base title="AI tool comparisons (X vs Y)" description={`Side-by-side comparisons of ${pairs.length} popular AI tool pairs: ChatGPT vs Claude, Cursor vs GitHub Copilot, Kimi vs Claude and more, with pricing, use cases and live X buzz.`} jsonld={[ld, crumbsLd([['Home', '/'], ['Comparisons', '/vs']])]}>
<Shell active="vs"><article class="card prose"><h1>AI tool comparisons</h1><p class="answer"><b>Short answer:</b> pick a pair below for a side-by-side table of pricing, use cases and live X buzz, plus a plain-English verdict on which to use. {pairs.length} comparisons live now.</p>
<ul>{pairs.map((p) => <li><a href={`/vs/${p.slug}`}><b>{p.a.name} vs {p.b.name}</b></a> ({p.a.category === p.b.category ? p.a.category : `${p.a.category} / ${p.b.category}`})</li>)}</ul>
</article></Shell></Base>
