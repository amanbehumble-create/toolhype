---
import Base from '../../layouts/Base.astro'; import Shell from '../../components/Shell.astro'; import Win98 from '../../components/Win98.astro';
import { getPacks, DRIP_TOTAL, essentialBadges } from '../../lib/creators'; import CreatorDrip from '../../components/CreatorDrip.astro'; import CreatorsCTA from '../../components/CreatorsCTA.astro'; import BadgeStyles from '../../components/BadgeStyles.astro'; import { crumbsLd, faqLd } from '../../lib/ld';
import { badgeHtml, creatorsItemListLd } from '../../lib/badge';
const packs = getPacks(); const ess = essentialBadges();
const faq: [string, string][] = [
  ['Who should I follow on X for AI and vibe coding?', `Start with toolhype's Essentials: ${ess.slice(0, 6).map((c) => c.name.replace(/^@/, '')).join(', ')} and the rest of the ${ess.length} essentials. Each one has a creator page with a one-line summary and a link to their X profile.`],
  ['How often are new X creators added?', `One new creator unlocks every day at midnight Hong Kong time until Dec 31, ${DRIP_TOTAL} in total. Recent picks are added by hand to keep the list current.`],
  ['What is an X creator starter pack?', 'A hand-curated list of X (Twitter) accounts worth following on one theme, grouped from must-follow essentials to deeper picks, with a one-line summary of what each person posts.'],
  ['How are creators chosen?', 'Picks are curated by the toolhype team from public X profiles. Nobody pays to be listed, and follower counts are a dated snapshot.'],
];
const packsLd = { '@context': 'https://schema.org', '@type': 'ItemList', name: 'X creator starter packs', numberOfItems: packs.length, itemListElement: packs.map((p, i) => ({ '@type': 'ListItem', position: i + 1, name: `Starter Pack #${p.n}: ${p.title}`, url: `https://toolhype.dev/creators/${p.slug}` })) };
---
<Base title="X creators worth following for AI and vibe coding" description="toolhype's handpicked list of X creators worth following for AI and vibe coding, with a new creator unlocked daily. Every creator gets a page with their bio and X link." jsonld={[creatorsItemListLd('X creators worth following: Essentials', ess), packsLd, faqLd(faq), crumbsLd([['Home', '/'], ['X Creators', '/creators']])]}>
<BadgeStyles />
<Shell active="creators"><article class="card prose cr-page">
  <h1>X creators worth following for AI and vibe coding</h1>
  <p class="answer"><b>Short answer:</b> toolhype's handpicked list of X creators worth following for AI and vibe coding, with a new creator unlocked daily. {ess.length} essentials are live now, and one more unlocks every day at midnight Hong Kong time until Dec 31 ({DRIP_TOTAL} in total).</p>
  <CreatorDrip />
  <div class="w98-desk">{packs.map((p) => (
    <Win98 title={`📁 Starter Pack #${p.n}.exe`}>
      <p style="margin:0 0 8px"><b>{p.title}</b><br/>{ess.length} essentials live, new creator daily. Snapshot {p.asOf}. <a class="w98-btn" href={`/creators/${p.slug}`}>Open full pack ▸</a></p>
      <ul class="w98-list" set:html={ess.map((c) => badgeHtml(c, 'mini')).join('')} />
    </Win98>))}
  </div>
  <CreatorDrip full />
  <CreatorsCTA source="creators" />
  <h2>FAQ</h2>{faq.map(([q, a]) => <><h3>{q}</h3><p>{a}</p></>)}
</article></Shell></Base>
