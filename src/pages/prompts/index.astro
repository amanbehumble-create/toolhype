---
import Subscribe from '../../components/Subscribe.astro';
import Base from '../../layouts/Base.astro'; import Shell from '../../components/Shell.astro'; import { getIssues } from '../../lib/prompts';
import { crumbsLd, faqLd } from '../../lib/ld';
const issues = getIssues();
const total = issues.reduce((n, i) => n + i.prompts.length, 0);
const faq: [string, string][] = [
  ['What is Prompt Drop?', 'A free weekly collection of beginner-friendly AI prompts, each copied from an X post with at least 100 likes, with a short note on why it works.'],
  ['Are the prompts free to use?', 'Yes. Copy, paste and swap the [brackets]. Credit stays with the original X authors linked on each prompt.'],
  ['How often do new issues come out?', 'About once a week. Browse past issues below or subscribe to get the next drop by email.'],
];
const ld = {
  '@context': 'https://schema.org', '@type': 'ItemList', name: 'Prompt Drop issues',
  numberOfItems: issues.length,
  itemListElement: issues.map((i, idx) => ({ '@type': 'ListItem', position: idx + 1, name: i.title, url: `https://toolhype.dev/prompts/${i.slug}` })),
};
---
<Base title="Prompt Drop: copy-paste AI prompts for beginners" description={`Free weekly AI prompts for beginners — ${total} prompts across ${issues.length} issues, each from an X post with 100+ likes. Copy, paste and get results.`} jsonld={[ld, faqLd(faq), crumbsLd([['Home', '/'], ['Prompt Drop', '/prompts']])]}>
<Shell active="prompts"><div class="prose"><h1>Prompt Drop</h1>
<p class="answer"><b>Short answer:</b> every week we pick AI prompts from X posts with at least 100 likes (we check every count), copy them word for word, and explain why they work. Copy, paste, swap the <code>[brackets]</code>, done. {total} prompts live across {issues.length} issues so far.</p>
{issues.map((i) => <a class="card post-link" href={`/prompts/${i.slug}`} style="display:block;margin:1rem 0;color:inherit"><div class="muted" style="font:500 .75rem var(--mono)">ISSUE #{i.n} · {i.date} · {i.prompts.length} prompts</div><h2 style="margin:.3rem 0">{i.title}</h2><p class="muted" style="margin:0">{i.prompts.map((p) => p.title).slice(0, 4).join(' · ')} …</p></a>)}
<div class="card"><p class="muted">Get Prompt Drop by email every week:</p><Subscribe place="prompts-index" /></div>
<h2>FAQ</h2>{faq.map(([q, a]) => <><h3>{q}</h3><p>{a}</p></>)}
</div></Shell></Base>
