---
import Base from '../layouts/Base.astro'; import Shell from '../components/Shell.astro';
const embed = import.meta.env.PUBLIC_BEEHIIV_EMBED_URL;
---
<Base title="The weekly drop newsletter" description="A free weekly email with the new AI tools worth trying, from Product Hunt, GitHub and X.">
<Shell><div class="prose"><h1>The weekly drop</h1><p>Every week: the new AI tools and software worth your time, what people on X are saying about them, and one useful stack tip. Free, takes 3 minutes to read.</p>
<div class="card">{embed ? <iframe src={embed} title="Subscribe" style="width:100%;height:320px;border:0" loading="lazy"></iframe> :
<p class="muted">Signups open soon. Follow <a href="https://x.com/amanbehumble">@amanbehumble</a> for now.</p>}</div>
<h2>Sample issue</h2><p class="muted">See <a href="/new">New this week</a>. Each issue is built from that page.</p></div></Shell></Base>
