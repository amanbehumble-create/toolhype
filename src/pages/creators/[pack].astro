---
import Base from '../../layouts/Base.astro'; import Shell from '../../components/Shell.astro'; import Win98 from '../../components/Win98.astro';
import { getPacks, fmtK, toolName, creatorsListLd, DRIP_TOTAL } from '../../lib/creators'; import CreatorDrip from '../../components/CreatorDrip.astro'; import CreatorsCTA from '../../components/CreatorsCTA.astro'; import { crumbsLd, faqLd } from '../../lib/ld';
export function getStaticPaths() { return getPacks().map((p) => ({ params: { pack: p.slug }, props: { p } })); }
const { p } = Astro.props;
const title = `Starter Pack #${p.n}: ${p.title}`;
const top = p.accounts.filter((c) => c.section === p.sections[0].key).slice(0, 5).map((c) => c.name.replace(/^@/, ''));
const ess = p.accounts.filter((c) => c.section === 'essentials');
const faq: [string, string][] = [
  ['When are the other creators revealed?', `One new creator unlocks every day at midnight Hong Kong time until Dec 31. ${ess.length} of ${DRIP_TOTAL} are live now, starting with the Essentials.`],
  [`Who should I follow on X for ${p.title.toLowerCase().replace(' on x', '')}?`, `Start with the ${p.sections[0].title} window: ${top.join(', ')} and the rest of the ${ess.length} essentials. New picks unlock daily below.`],
  ['Are follower counts live?', `No. They are a snapshot from ${p.asOf}.`],
];
---
<Base title={`${title}: ${ess.length} essentials + a new creator daily`} description={`${ess.length} essential X creators for builders, writers and thinkers: ${top.join(', ')} and more, with one-line summaries, and a new creator unlocked every day until Dec 31. Retro Windows 98 directory.`} jsonld={[creatorsListLd(title, p.accounts), faqLd(faq), crumbsLd([['Home', '/'], ['X Creators', '/creators'], [`Starter Pack #${p.n}`, `/creators/${p.slug}`]])]}>
<Shell active="creators"><article class="card prose">
  <p class="muted"><a href="/creators">X Creators</a> › Starter Pack #{p.n}</p>
  <h1>{title}</h1>
  <p class="answer"><b>Short answer:</b> start with these {ess.length} essential X accounts, like {top.slice(0, 3).join(', ')}. The rest of the {DRIP_TOTAL}-creator pack unlocks one per day. Every card links straight to the creator's X profile.</p>
  <CreatorDrip />
  <div class="w98-desk">{p.sections.slice(0, 1).map((s) => (
    <Win98 id={s.key} title={`${s.n} ${s.title}.exe`}>
      <ul class="w98-list">{p.accounts.filter((c) => c.section === s.key).map((c) => (
        <li class="w98-item" id={c.handle}>
          <img src={c.avatar} alt={`${c.name} on X`} width="48" height="48" loading="lazy"/>
          <div><b><a href={`https://x.com/${c.handle}`} rel="noopener" target="_blank">{c.name}</a></b><small>@{c.handle} · {fmtK(c.followers)} followers</small>
          <p>{c.descriptor}</p>
          {c.tools.length > 0 && <p>On toolhype: {c.tools.map((t, i) => <>{i > 0 && ', '}<a href={`/tools/${t}`}>{toolName(t)}</a></>)}</p>}</div>
        </li>))}
      </ul>
    </Win98>))}
  </div>
  <CreatorDrip full />
  <CreatorsCTA source={`creators/${p.slug}`} />
  <p class="muted">Follower figures are a {p.asOf} snapshot. Avatars from public X profiles. Summaries are our own one-liners from public bios. Missing someone? <a href="https://x.com/amanbehumble" rel="noopener">Tell us on X</a>.</p>
  <h2>FAQ</h2>{faq.map(([q, a]) => <><h3>{q}</h3><p>{a}</p></>)}
</article></Shell></Base>
