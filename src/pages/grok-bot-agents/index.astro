---
import Base from '../../layouts/Base.astro'; import Shell from '../../components/Shell.astro';
import { getAgents, agentCategories, creatorLabel, AGENTS_INTRO } from '../../lib/agents'; import { crumbsLd } from '../../lib/ld';
const agents = getAgents();
const site = Astro.site!;
const listLd = { '@context': 'https://schema.org', '@type': 'ItemList', name: 'Grok Bot agents', itemListElement: agents.map((a, i) => ({ '@type': 'ListItem', position: i + 1, url: new URL(`/grok-bot-agents/${a.slug}`, site).href, name: a.name })) };
---
<Base title="Grok Bot agents: ready-to-use templates" description={`${AGENTS_INTRO} Free public Grok Bot templates for research, privacy, coding, selling, finance and more.`} jsonld={[crumbsLd([['Home', '/'], ['Grok Bot agents', '/grok-bot-agents']]), listLd]}>
<Shell active="grok-bot-agents"><div class="prose"><h1>Grok Bot agents</h1>
<p>{AGENTS_INTRO} Each one is a free public template: hit <b>Add to Grok Bot</b> and it opens in Grok Bot, ready to set up. We only list agents with a working public share link.</p>
<p class="muted" style="font-size:.8rem">{agents.length} agents · {agentCategories().join(' · ')}</p></div>
<div class="feed" data-track-zone="agents">
{agents.map((a) => <article class="post agent" data-search={`${a.name} ${a.description} ${a.category} ${creatorLabel(a)}`.toLowerCase()}>
  <div style="flex:1;min-width:0">
    <div class="meta" style="display:flex;gap:.4rem;flex-wrap:wrap;align-items:center"><span class="chip c">{a.category}</span><span class="muted" style="font-size:.75rem">by {a.creatorHandle ? <a href={`https://x.com/${a.creatorHandle}`} target="_blank" rel="noopener">@{a.creatorHandle}</a> : creatorLabel(a)}</span>{a.traction && <span class="muted" style="font:500 .7rem var(--mono)">♥ {a.traction.likes} · 🔖 {a.traction.bookmarks}</span>}</div>
    <h3 style="margin-top:.35rem"><a href={`/grok-bot-agents/${a.slug}`}>{a.name}</a></h3>
    <p>{a.description}</p>
    <div style="display:flex;gap:.5rem;flex-wrap:wrap"><a class="btn primary" href={a.templateUrl} target="_blank" rel="noopener" data-track={`agent:add:${a.slug}`}>Add to Grok Bot ↗</a><a class="btn" href={`/grok-bot-agents/${a.slug}`}>Details</a></div>
  </div>
</article>)}
</div>
<div class="card" style="margin-top:1rem"><p class="muted" style="margin:0">Built a Grok Bot agent with a public share link? <a href="/submit" style="color:var(--accent-ink)">Send it to us →</a> Likes and bookmarks are from the creator's original X post, checked on the date shown on each agent's page.</p></div>
</Shell></Base>
