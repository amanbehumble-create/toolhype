---
import Base from '../layouts/Base.astro'; import Shell from '../components/Shell.astro'; import ShareBar from '../components/ShareBar.astro';
const stripe = import.meta.env.PUBLIC_STRIPE_FEATURED_LINK;
---
<Base title="Submit a tool / Get featured" description="List your AI tool on toolhype for free, or get a featured spot in front of builders and marketers.">
<Shell><div class="prose"><h1>Submit your tool</h1>
<div class="sharecta" data-track-zone="submit-share"><span class="muted">Know a maker who should be listed? Send them the free submit page.</span><ShareBar path="/submit" text="Built an AI tool? Submit it free to toolhype.dev, the AI tools directory ranked by buzz on X 🚀" track="submit-page" label="Share the submit page" /></div>
<style>.sharecta{display:flex;gap:.6rem 1rem;flex-wrap:wrap;align-items:center;justify-content:space-between;margin:.2rem 0 1rem}.sharecta .muted{font-size:.9rem}#subshare{margin-top:.8rem;padding:.8rem 1rem;border:1px solid var(--line,rgba(127,127,127,.3));border-radius:14px}#subshare[hidden]{display:none}#subshare p{margin:0 0 .5rem}</style>
<div class="card"><h2>Free listing</h2><p class="muted">We review every submission. Approved tools go into the feed and the weekly newsletter.</p>
<form id="subform" data-track="submit:tool-form" novalidate><input class="field" name="name" placeholder="Tool name" maxlength="80" required/><input class="field" name="url" type="url" placeholder="https://" maxlength="300" required/><textarea class="field" name="pitch" rows="3" maxlength="600" placeholder="What does it do, and who is it for?"></textarea>
<label class="muted" style="display:block;margin:.6rem 0 .2rem;font-size:.9rem"><b>How can we contact you?</b> Email or X handle, at least one.</label>
<input class="field" name="email" type="email" maxlength="120" placeholder="you@email.com"/><input class="field" name="x" maxlength="40" placeholder="@yourhandle on X (optional)"/>
<div aria-hidden="true" style="position:absolute;left:-9999px;width:1px;height:1px;overflow:hidden"><input name="website" tabindex="-1" autocomplete="off"/></div>
<button class="btn" type="submit">Submit for free</button><div id="submsg" role="status" aria-live="polite"></div></form>
<div id="subshare" hidden><p><b>Share that you submitted</b> and let your followers know your tool is up for a listing.</p><div class="sharebar" style="display:flex;gap:.5rem;flex-wrap:wrap"><a class="btn primary" id="subshare-x" href="https://x.com/intent/post" target="_blank" rel="noopener" data-track="share:x:submitted"><b aria-hidden="true">𝕏</b>&nbsp;Share on X</a><button class="btn" type="button" data-copy="https://toolhype.dev/submit?ref=link" data-track="share:copy:submitted">🔗&nbsp;<span>Copy link</span></button></div></div>
<style>#submsg{margin-top:.7rem;font-size:.95rem}#submsg:empty{display:none}#submsg.ok,#submsg.err{display:inline-block;padding:.55rem .9rem;border-radius:999px}#submsg.ok{background:rgba(34,197,94,.14);color:#22c55e;border:1px solid rgba(34,197,94,.4)}#submsg.err{background:rgba(239,68,68,.12);color:#ef4444;border:1px solid rgba(239,68,68,.35)}</style>
<script is:inline>(()=>{const f=document.getElementById('subform'),m=document.getElementById('submsg'),b=f.querySelector('button');const say=(t,c)=>{m.textContent=t;m.className=c};f.addEventListener('submit',async ev=>{ev.preventDefault();const d=Object.fromEntries(new FormData(f));if(!d.name.trim())return say('Please add the tool name.','err');if(!d.url.trim())return say('Please add the tool URL.','err');if(!d.email.trim()&&!d.x.trim())return say('Please leave an email or X handle so we can reach you.','err');b.disabled=true;say('Sending…','');try{const r=await fetch('/api/submit',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(d)});const j=await r.json().catch(()=>({}));if(r.ok&&j.ok){const nm=String(d.name).trim().slice(0,60);f.reset();say('Submitted ✓, thanks! We\'ll review it and reach out.','ok');const sh=document.getElementById('subshare'),u='https://toolhype.dev/submit?ref=x-submitted';document.getElementById('subshare-x').href='https://x.com/intent/post?'+new URLSearchParams({text:'I just submitted '+nm+' to toolhype.dev, the AI tools directory ranked by buzz on X 🚀 Got a tool? Submit yours free:',url:u,via:'amanbehumble'});sh.hidden=false;let rf='';try{rf=sessionStorage.getItem('th:ref')||''}catch{}try{if(!navigator.webdriver)navigator.sendBeacon('/api/e',JSON.stringify({k:'submit',p:'/submit',e:'submit:tool-form-ok',l:rf?'ref:'+rf:'tool submitted'}))}catch{}}else say(j.error||'Something went wrong. Please try again.','err')}catch{say('Network error. Please try again.','err')}b.disabled=false})})();</script></div>
<div class="card" style="margin-top:1rem;border-color:var(--cyan)"><h2>Featured listing</h2><p class="muted">A clearly labelled slot in the sidebar, at the top of a community, and in the newsletter. Featured spots never change organic rank.</p>
{stripe ? <a class="btn primary" href={stripe}>Get featured →</a> : <button class="btn primary" disabled>Featured spots open soon</button>}</div></div></Shell></Base>
