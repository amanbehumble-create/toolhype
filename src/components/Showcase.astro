---
// Homepage bento. Planned with Stageshow's bento rules: one hero, UI on about
// a third of the tiles, neighbors are different kinds, each real name once,
// copy outside the picture, one small motion per tile. Built from live site
// data (no stock art). The React kit is not vendored: this page stays static.
import { getTools, byBuzz, LABEL } from '../lib/data';
import { getPairs } from '../lib/geo';
import { getIssues } from '../lib/prompts';
import { essentials } from '../lib/creators';
import { shortName } from '../lib/top';

const ranked = [...getTools()].filter((t) => t.buzz.status === 'live' && t.buzz.score != null).sort(byBuzz);
const lead = ranked[0];
const strip = ranked.slice(1, 9);
const taken = new Set([lead?.slug, ...strip.map((t) => t.slug)]);
const pair = getPairs().find((p) => p.a.buzz.score != null && p.b.buzz.score != null && !taken.has(p.a.slug) && !taken.has(p.b.slug));
const issue = getIssues()[0];
const prompt = issue?.prompts[0];
const essentialsLive = essentials().length;
const compact = (n: number) => (n >= 1000 ? `${(n / 1000).toFixed(1).replace(/\.0$/, '')}k` : String(n));
const meta = lead
  ? [LABEL[lead.buzz.label || ''] || '', lead.buzz.mentions24h ? `${compact(lead.buzz.mentions24h)} posts in 24h` : ''].filter(Boolean).join(' · ')
  : '';
---
{lead && issue && prompt && (
<section class="show" aria-label="What toolhype tracks" data-track-zone="showcase">
  <div class="show-grid">
    <a class="tile tile-buzz" href="/buzz">
      <h2 class="tc"><b>Live X Buzz.</b> <span>One score, from posts on X.</span></h2>
      <div class="buzz-ui">
        <div class="buzz-who">
          {lead.logo && <img src={lead.logo} alt="" width="40" height="40" decoding="async" />}
          <div>
            <div class="buzz-name">{shortName(lead.name)}</div>
            {meta && <div class="buzz-meta">{meta}</div>}
          </div>
        </div>
        <div class="buzz-score">
          <div class="buzz-num">{lead.buzz.score}<span>/100</span></div>
          <div class="meter" aria-hidden="true"><i style={`width:${lead.buzz.score}%`}></i></div>
        </div>
      </div>
    </a>

    <a class="tile tile-top" href="/?sort=buzz">
      <h2 class="tc"><b>Top hyped.</b> <span>Right behind the leader.</span></h2>
      <div class="marks-clip"><div class="marks">
        {strip.map((t, i) => (
          <div class="mark" style={`--d:${80 + i * 45}ms`}>
            {t.logo
              ? <img src={t.logo} alt="" width={i === 0 ? 48 : 36} height={i === 0 ? 48 : 36} decoding="async" />
              : <span class="ph" aria-hidden="true">{t.name[0]}</span>}
            {i === 0 && <span class="mark-name">{shortName(t.name)}</span>}
          </div>
        ))}
      </div></div>
    </a>

    {pair && (
    <div class="tile tile-vs">
      <h2 class="tc"><a href="/vs">Vs</a> <span>and</span> <a href="/best">best</a><span>. Pairs, or by category.</span></h2>
      <a class="vs" href={`/vs/${pair.slug}`}>
        <div class="vs-row"><span>{shortName(pair.a.name)}</span><b>{pair.a.buzz.score}</b></div>
        <div class="vs-mid" aria-hidden="true"><i></i><em>vs</em><i></i></div>
        <div class="vs-row"><span>{shortName(pair.b.name)}</span><b>{pair.b.buzz.score}</b></div>
      </a>
    </div>
    )}

    <a class="tile tile-drop" href={`/prompts/${issue.slug}`}>
      <h2 class="tc"><b>Prompt Drop.</b> <span>{issue.prompts.length} prompts this week.</span></h2>
      <div class="paper">
        <div class="paper-k">Drop #{issue.n}</div>
        <div class="paper-t">{prompt.title}</div>
        <div class="paper-c">{prompt.category}</div>
      </div>
    </a>

    <a class="tile tile-creators" href="/creators">
      <h2 class="tc"><b>X creators.</b> <span>A new pass unlocks daily.</span></h2>
      <div class="stat">
        <div class="stat-n">{essentialsLive}</div>
        <i class="stat-rule" aria-hidden="true"></i>
        <div class="stat-l">essentials live</div>
      </div>
    </a>
  </div>
</section>
)}
<style>
.show{container-type:inline-size;margin:0 0 1.15rem}
.show-grid{display:grid;grid-template-columns:1.25fr .75fr;gap:12px}
.tile-buzz{grid-column:1 / -1}
.tile{display:flex;flex-direction:column;align-items:stretch;min-width:0;background:var(--surface);border:1px solid var(--line);border-radius:var(--r-card);padding:16px;color:inherit;text-decoration:none;transition:border-color .18s var(--ease),box-shadow .18s var(--ease)}
a.tile:hover,.tile:hover{color:inherit;border-color:var(--line-strong);box-shadow:0 10px 24px color-mix(in srgb,var(--ink) 6%,transparent)}
.show a:focus-visible{outline:2px solid var(--cyan);outline-offset:3px}
.tc{margin:0;font:400 1.0625rem/1.35 var(--sans);letter-spacing:0;color:var(--ink)}
.tc b,.tc a{font-family:var(--display);font-weight:650;letter-spacing:-.02em;color:var(--ink)}
.tc span{color:var(--ink-2);font-weight:400}
.tile-vs .tc a:hover{color:var(--accent-ink)}

.buzz-ui{display:flex;align-items:flex-end;justify-content:space-between;gap:20px;margin-top:14px}
.buzz-who{display:flex;align-items:center;gap:12px;min-width:0}
.buzz-who img,.mark img,.ph{flex:none;background:#fff;border:1px solid var(--line);object-fit:contain;box-sizing:border-box}
.buzz-who img{width:40px;height:40px;border-radius:10px;padding:3px}
.buzz-name{font:650 1.05rem/1.25 var(--display);letter-spacing:-.02em}
.buzz-meta{margin-top:2px;font:500 .75rem/1.35 var(--mono);color:var(--ink-2)}
.buzz-score{flex:0 1 260px;min-width:140px}
.buzz-num{font:800 3.25rem/.9 var(--display);letter-spacing:-.045em;font-variant-numeric:tabular-nums;white-space:nowrap}
.buzz-num span{margin-left:.35rem;font:500 .85rem/1 var(--mono);letter-spacing:0;color:var(--ink-3)}
.meter{height:8px;margin-top:10px;border-radius:99px;background:var(--field);overflow:hidden}
.meter i{display:block;height:100%;border-radius:inherit;background:var(--cyan);transform-origin:left center}

.tile-top{overflow:hidden}
.marks-clip{margin:14px -16px 0 0;overflow:hidden;-webkit-mask-image:linear-gradient(90deg,#000 68%,transparent);mask-image:linear-gradient(90deg,#000 68%,transparent)}
.marks{display:flex;align-items:flex-start;gap:10px;min-height:74px}
.mark{display:flex;flex-direction:column;align-items:center;gap:6px;flex:none}
.mark img,.ph{width:36px;height:36px;border-radius:10px;padding:3px}
.mark:first-child img,.mark:first-child .ph{width:48px;height:48px;border-radius:12px}
.ph{display:grid;place-items:center;font:600 1rem var(--display);color:var(--ink);padding:0}
.mark-name{max-width:5.5rem;font:500 .75rem/1.2 var(--sans);text-align:center;color:var(--ink)}

.vs{display:block;margin-top:14px;color:inherit;text-decoration:none}
.vs-row{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:10px;align-items:baseline}
.vs-row span{font:650 .95rem/1.3 var(--display);letter-spacing:-.02em}
.vs-row b{font:600 .95rem/1 var(--mono);color:var(--accent-ink);font-variant-numeric:tabular-nums}
.vs-mid{display:flex;align-items:center;gap:8px;margin:8px 0;color:var(--ink-3)}
.vs-mid i{flex:1;height:1px;background:var(--line-strong);transform-origin:center}
.vs-mid em{font:500 .68rem/1 var(--mono);font-style:normal;letter-spacing:.08em}

.paper{align-self:flex-start;max-width:17.5rem;margin:16px 6px 4px;padding:14px 14px 12px;background:#f4f0e6;color:#1a1a1a;border-radius:3px 12px 12px 12px;box-shadow:0 12px 28px color-mix(in srgb,#000 12%,transparent),0 0 0 1px color-mix(in srgb,#000 6%,transparent);transform:rotate(-1.5deg)}
.paper-k{font:600 .68rem/1 var(--mono);letter-spacing:.12em;text-transform:uppercase;color:#00749e}
.paper-t{margin-top:6px;font:650 .95rem/1.35 var(--display);letter-spacing:-.02em;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.paper-c{margin-top:8px;font:500 .75rem/1.3 var(--mono);color:#616161}
:global([data-theme="dark"]) .paper{box-shadow:0 16px 36px rgba(0,0,0,.5),0 0 0 1px rgba(255,255,255,.08)}

.stat{margin-top:10px}
.stat-n{font:800 3.5rem/.85 var(--display);letter-spacing:-.045em;font-variant-numeric:tabular-nums}
.stat-rule{display:block;width:2rem;height:3px;margin:8px 0 6px;border-radius:99px;background:var(--cyan);transform-origin:left center}
.stat-l{font:500 .8rem/1.3 var(--mono);color:var(--ink-2)}

@media (prefers-reduced-motion:no-preference){
  .meter i{animation:th-meter 1.05s cubic-bezier(.25,.8,.25,1) both}
  .mark{animation:th-mark .7s cubic-bezier(.45,0,.1,1) both;animation-delay:var(--d,0ms)}
  .vs-mid i{animation:th-line .6s cubic-bezier(.45,0,.1,1) .2s both}
  .paper{animation:th-paper .9s cubic-bezier(.25,.8,.25,1) .32s both}
  .stat-rule{animation:th-line .5s cubic-bezier(.25,.8,.25,1) .44s both}
}
@keyframes th-meter{from{transform:scaleX(0)}}
@keyframes th-mark{from{opacity:0;transform:translateY(6px)}}
@keyframes th-line{from{transform:scaleX(0)}}
@keyframes th-paper{from{transform:rotate(-5.5deg) translateY(8px)}to{transform:rotate(-1.5deg)}}
@media (prefers-reduced-motion:reduce){
  .meter i,.mark,.vs-mid i,.stat-rule{animation:none;transform:none}
  .paper{animation:none;transform:rotate(-1.5deg)}
  .tile{transition:border-color .15s var(--ease)}
}
@container (max-width:560px){
  .show-grid{grid-template-columns:1fr}
  .buzz-ui{flex-direction:column;align-items:stretch}
  .buzz-score{flex-basis:auto}
  .buzz-num{font-size:2.75rem}
}
</style>
