---
const { source = 'creators' } = Astro.props;
---
<div class="w98-desk" style="margin-top:1rem"><section class="w98"><div class="w98-bar"><span>📬 Stay_in_the_loop.exe</span><span class="w98-btns" aria-hidden="true"><i>_</i><i>□</i><i>×</i></span></div><div class="w98-body">
  <p style="margin:0 0 8px"><b>Don't miss tomorrow's creator.</b> Bookmark toolhype or get more useful X resources by email.</p>
  <p style="margin:0 0 8px"><button type="button" class="w98-btn" id="bm-btn">⭐ Bookmark toolhype</button><span id="bm-tip" role="status" style="font-size:12px"></span></p>
  <form id="rs-form" style="display:flex;gap:6px;flex-wrap:wrap;align-items:center" novalidate>
    <label for="rs-email" style="font-weight:700">Get more useful X resources:</label>
    <input id="rs-email" name="email" type="email" required placeholder="you@example.com" autocomplete="email" style="padding:3px 6px;border:2px solid;border-color:#808080 #fff #fff #808080;min-width:200px;font:inherit"/>
    <input name="website" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px;width:1px;height:1px"/>
    <input type="hidden" name="source" value={source}/>
    <button class="w98-btn" type="submit">Sign me up ▸</button>
  </form>
  <p id="rs-msg" role="status" style="margin:6px 0 0;font-size:12px"></p>
  <p style="margin:6px 0 0;font-size:11px;color:#333">We only email useful X resources. No spam, unsubscribe anytime.</p>
</div></section></div>
<script>
  const bm = document.getElementById('bm-btn'), tip = document.getElementById('bm-tip');
  bm?.addEventListener('click', async () => {
    const mobile = matchMedia('(pointer:coarse)').matches;
    if (mobile && navigator.share) { try { await navigator.share({ title: 'toolhype: X creators & AI tools', url: location.href }); return; } catch {} }
    const mac = /Mac|iPhone|iPad/.test(navigator.platform || navigator.userAgent);
    if (tip) tip.textContent = mobile ? ' Tap your browser menu, then "Add bookmark" or "Add to Home Screen".' : ` Press ${mac ? '⌘' : 'Ctrl'}+D to bookmark this page.`;
  });
  const f = document.getElementById('rs-form') as HTMLFormElement | null, msg = document.getElementById('rs-msg');
  f?.addEventListener('submit', async (e) => {
    e.preventDefault(); const d = Object.fromEntries(new FormData(f));
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(String(d.email || '').trim())) { if (msg) msg.textContent = 'That email doesn’t look right.'; return; }
    const btn = f.querySelector('button[type=submit]') as HTMLButtonElement; btn.disabled = true;
    try {
      const r = await fetch('/api/resource-signup', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(d) });
      const j = await r.json().catch(() => ({}));
      if (r.ok) { f.style.display = 'none'; if (msg) msg.innerHTML = '✅ <b>You’re on the list!</b> We’ll send you the best X resources as we find them.'; }
      else { if (msg) msg.textContent = j.error || 'Something went wrong. Please try again.'; btn.disabled = false; }
    } catch { if (msg) msg.textContent = 'Network error. Please try again.'; btn.disabled = false; }
  });
</script>
