---
import '@fontsource-variable/funnel-sans';
import '@fontsource-variable/funnel-display';
import '@fontsource-variable/geist-mono';
import '../styles.css';
import { SITE } from '../lib/data';
interface Props { title?: string; description?: string; jsonld?: object[]; ogType?: string; noindex?: boolean; ogImage?: string }
const { title, description: d0 = SITE.tagline, jsonld = [], ogType = 'website', noindex = false, ogImage = '/og/default.png' } = Astro.props;
const ogImg = new URL(ogImage, Astro.site);
const description = d0.length > 160 ? d0.slice(0, 157).replace(/\s+\S*$/, '') + '…' : d0;
const full = title ? (title.length > 50 ? title : `${title} · ${SITE.name}`) : `${SITE.name} — ${SITE.tagline}`;
let path = Astro.url.pathname.replace(/\.html$/, '');
if (path === '/index' || path === '') path = '/';
else path = path.replace(/\/$/, '');
const canonical = new URL(path, Astro.site);
---
<!doctype html><html lang="en"><head>
<meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
<title>{full}</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/>
<meta property="og:title" content={full}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:type" content={ogType}/>{noindex && <meta name="robots" content="noindex"/>}<meta property="og:site_name" content={SITE.name}/>
<meta property="og:image" content={ogImg}/><meta property="og:image:width" content="1200"/><meta property="og:image:height" content="630"/><meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content={full}/><meta name="twitter:description" content={description}/><meta name="twitter:image" content={ogImg}/><meta name="twitter:site" content="@amanbehumble"/>
<link rel="alternate" type="application/rss+xml" title="toolhype — New this week" href="/rss.xml"/>
<link rel="icon" href="/favicon.svg"/>
<script is:inline>document.documentElement.dataset.theme=localStorage.getItem('th:theme')||(matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light')</script>
{jsonld.map((j) => <script type="application/ld+json" set:html={JSON.stringify(j).replace(/</g, "\\u003c")} />)}
</head><body>
<header class="top" data-track-zone="topnav"><a class="logo" href="/">tool<b>hype</b></a>
<input class="search" id="q" data-track="search" type="search" placeholder="Search AI tools…" aria-label="Search"/>
<a class="btn hide-sm" href="/new">New this week</a><a class="btn hide-sm" href="/prompts">Prompt Drop</a><a class="subcount" href="/submit" data-track="subcount:nav" title="Projects submitted to toolhype"><span class="dot" aria-hidden="true"></span><b data-subcount>—</b><span class="hide-sm">&nbsp;submitted</span></a><a class="btn primary" href="/submit">Get featured</a>
<button class="btn" data-track="theme" id="theme" aria-label="Toggle theme">◐</button></header>
<slot/>
<div class="subbar" id="subbar" role="region" aria-label="Newsletter"><b>✉️ The weekly AI tools drop</b><a class="btn primary" data-track="sub:subbar" href="https://adrians-newsletter-156c86.beehiiv.com/subscribe" target="_blank" rel="noopener">Subscribe</a><button class="x" aria-label="Dismiss" type="button">✕</button></div>
<footer data-track-zone="footer">toolhype · <a href="/newsletter">Newsletter</a> · <a href="/prompts">Prompt Drop</a> · <a href="/grok-bot-agents">Grok Bot agents</a> · <a href="/rss.xml">RSS</a> · <a href="/trending">Trending AI tools today</a> · <a href="/hype">Most hyped this week</a> · <a href="/vs">Comparisons</a> · <a href="/best">Best AI tools by category</a> · <a href="/llms.txt">llms.txt</a> · Featured listings are labelled and never affect ranking.</footer>
<script>
document.getElementById('theme')!.addEventListener('click',()=>{const d=document.documentElement;d.dataset.theme=d.dataset.theme==='dark'?'light':'dark';localStorage.setItem('th:theme',d.dataset.theme!)});
{const b=document.getElementById('subbar')!;const k='th:subbar';
if(!localStorage.getItem(k)&&!location.pathname.startsWith('/newsletter')){const on=()=>{if(scrollY>innerHeight*.8){b.classList.add('show');document.body.classList.add('has-subbar');removeEventListener('scroll',on)}};addEventListener('scroll',on,{passive:true})}
const off=()=>{b.classList.remove('show');document.body.classList.remove('has-subbar');localStorage.setItem(k,'1')};b.querySelector('.x')!.addEventListener('click',off);b.querySelector('a')!.addEventListener('click',off)}
const q=document.getElementById('q') as HTMLInputElement;
q.addEventListener('input',()=>{const v=q.value.toLowerCase();document.querySelectorAll<HTMLElement>('.post').forEach(p=>{p.style.display=(p.dataset.search||'').includes(v)?'':'none'})});
q.addEventListener('keydown',e=>{if(e.key==='Enter'&&!document.querySelector('.post'))location.href='/?q='+encodeURIComponent(q.value)});
{const els=document.querySelectorAll<HTMLElement>('[data-subcount]');if(els.length){const K='th:subcount';const paint=(n:number,anim:boolean)=>{const reduce=matchMedia('(prefers-reduced-motion: reduce)').matches;els.forEach(el=>{if(!anim||reduce){el.textContent=String(n);return}const t0=performance.now(),d=900;const f=(t:number)=>{const k=Math.min(1,(t-t0)/d);el.textContent=String(Math.round(n*(1-Math.pow(1-k,3))));if(k<1)requestAnimationFrame(f)};requestAnimationFrame(f);setTimeout(()=>{el.textContent=String(n)},d+150)})};
const c=Number(sessionStorage.getItem(K));if(c>0)paint(c,false);
fetch('/api/submissions-count').then(r=>r.ok?r.json():null).then(j=>{const n=j&&Number(j.count);if(n>0){if(n!==c)paint(n,!c);sessionStorage.setItem(K,String(n))}else if(!c)els.forEach(el=>el.closest('.subcount,.subcount-card')?.classList.add('off'))}).catch(()=>{if(!c)els.forEach(el=>el.closest('.subcount,.subcount-card')?.classList.add('off'))})}}
</script>
<script is:inline>(()=>{if(navigator.webdriver||/bot|crawl|spider|headless|toolhype-scan/i.test(navigator.userAgent))return;const p=location.pathname.replace(/\.html$/,'').replace(/(.)\/$/,'$1')||'/';const s=(k,e,l)=>{try{navigator.sendBeacon('/api/e',JSON.stringify({k,p,e:(e||'').slice(0,80),l:(l||'').replace(/\s+/g,' ').trim().slice(0,80)}))}catch{}};s('view','',document.referrer?new URL(document.referrer).hostname:'');
document.addEventListener('click',ev=>{const t=ev.target.closest&&ev.target.closest('[data-track],a,button');if(!t||t.tagName==='FORM')return;if(t.closest('form[data-track]')&&t.tagName==='BUTTON')return;let e=t.dataset.track;if(!e){const z=t.closest('[data-track-zone]');const h=t.getAttribute('href')||'';e=(z?z.dataset.trackZone:'body')+':'+(h.startsWith('/go/')?'visit':h?h.split('?')[0].slice(0,60):t.tagName.toLowerCase())}s('click',e,t.getAttribute('aria-label')||t.textContent)},{capture:true,passive:true});
document.addEventListener('submit',ev=>{const f=ev.target;s('submit',f.dataset.track||'form','')},{capture:true});
let st;document.addEventListener('input',ev=>{if(ev.target.id!=='q')return;clearTimeout(st);st=setTimeout(()=>{const v=ev.target.value;if(v.length>1)s('search','search',v)},1200)},{passive:true});})()</script>
<script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token":"f8769e39a55648cabd350783a6a24eea","version":"2024.6.1","send":{"to":"/cdn-cgi/rum"}}'></script>
</body></html>
