---
const { title, id = undefined } = Astro.props;
---
<section class="w98" id={id}><div class="w98-bar"><span>{title}</span><span class="w98-btns" aria-hidden="true"><i>_</i><i>□</i><i>×</i></span></div><div class="w98-body"><slot /></div></section>
<style is:global>
.w98{background:#c0c0c0;border:2px solid;border-color:#fff #404040 #404040 #fff;box-shadow:1px 1px 0 #000;margin:0 0 1rem;color:#000;font-family:Tahoma,"MS Sans Serif",Arial,sans-serif;font-size:13px}
.w98-bar{background:linear-gradient(90deg,#000080,#1084d0);color:#fff;font-weight:700;padding:3px 4px 3px 6px;display:flex;justify-content:space-between;align-items:center}
.w98-btns i{display:inline-block;width:16px;height:14px;line-height:12px;text-align:center;background:#c0c0c0;color:#000;font-style:normal;font-size:10px;margin-left:2px;border:1px solid;border-color:#fff #404040 #404040 #fff}
.w98-body{padding:8px}
.w98-desk{background:#008080;padding:12px;border-radius:6px}
.w98 a{color:#00e}
.w98-list{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(auto-fill,minmax(250px,1fr));gap:6px}
.w98-item{display:flex;gap:8px;background:#fff;border:2px solid;border-color:#808080 #fff #fff #808080;padding:6px;scroll-margin-top:80px}
.w98-item:target{outline:2px dashed #000080}
.w98-item img{width:48px;height:48px;flex:none;image-rendering:auto;border:1px solid #808080}
.w98-item b{display:block}.w98-item small{color:#555}
.w98-item p{margin:.2rem 0 0;font-size:12px;line-height:1.35}
.w98-btn{display:inline-block;background:#c0c0c0;color:#000!important;text-decoration:none;padding:3px 12px;border:2px solid;border-color:#fff #404040 #404040 #fff;margin:2px 4px 2px 0}
.w98-btn:active{border-color:#404040 #fff #fff #404040}
</style>
