---
import { getCommunities, getTools } from '../lib/data';
import Votes from './Votes.astro';
const { active = '' } = Astro.props;
const featured = getTools().filter((t) => t.featured);
const stripe = import.meta.env.PUBLIC_STRIPE_FEATURED_LINK;
---
<div class="grid">
  <aside class="left"><nav>
    <a href="/" class:list={{ on: active === 'home' }}>🏠 Home</a>
    <a href="/new" class:list={{ on: active === 'new' }}>✨ New this week</a>
    <a href="/newsletter">✉️ Newsletter</a>
    <div class="label">Communities</div>
    {getCommunities().map((c) => <a href={`/c/${c.slug}`} class:list={{ on: active === c.slug }}>c/{c.slug}</a>)}
  </nav></aside>
  <main><slot/></main>
  <aside class="right">
    <slot name="about"/>
    <div class="card"><h3>The weekly drop</h3><p class="muted">New AI tools from Product Hunt, GitHub and X, every week. Free.</p>
      <form action="/newsletter" method="get"><input class="field" type="email" name="email" placeholder="you@email.com" required/><button class="btn primary" style="width:100%;justify-content:center">Subscribe</button></form></div>
    <div class="card"><h3>Featured</h3>
      {featured.length ? featured.map((t) => <p><a href={`/tools/${t.slug}`}>{t.name}</a></p>) :
        <p class="muted">This slot is open. Featured spots are clearly labelled and never change ranking.</p>}
      <a class="btn" href={stripe || '/submit'}>Get featured →</a></div>
    <div class="card"><h3>Trending on X</h3><p class="muted">Live X buzz scores are coming soon. We're wiring up the daily X scan.</p></div>
  </aside>
</div>
<Votes/>
