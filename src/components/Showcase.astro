---
// Compact homepage bento. Live X Buzz cycles the top 5 (the still list is the
// reduced-motion poster). Prompt Drop sits beside the Substack signup; X
// creators stays in the grid. Vs/best and the logo strip are gone: they
// repeated the same tools.
// Subscribe hands off to the publication behind @amanbehumble. Substack's
// /subscribe page reads ?email= and prefills the field (no secret, no iframe).
// Real data only.
import { getTools, byBuzz, LABEL } from '../lib/data';
import { getIssues } from '../lib/prompts';
import { essentials } from '../lib/creators';
import { shortName } from '../lib/top';

const top = [...getTools()].filter((t) => t.buzz.status === 'live' && t.buzz.score != null).sort(byBuzz).slice(0, 5);
const issue = getIssues()[0];
const prompt = issue?.prompts[0];
const essentialsLive = essentials().length;
const SUBSTACK_SUBSCRIBE = 'https://amanbehumble.substack.com/subscribe';
const compact = (n: number) => (n >= 1000 ? `${(n / 1000).toFixed(1).replace(/\.0$/, '')}k` : String(n));
const line = (t: (typeof top)[number]) => {
  const bits = [LABEL[t.buzz.label || ''] || '', t.buzz.mentions24h ? `${compact(t.buzz.mentions24h)} posts in 24h` : ''].filter(Boolean);
  return bits.join(' · ');
};
---
{top.length > 0 && issue && prompt && (
<section class="show" aria-label="What toolhype tracks" data-track-zone="showcase">
  <div class="show-grid">
    <a class="tile tile-buzz" href="/buzz">
      <h2 class="tc"><b>Live X Buzz.</b> <span>Top five, from posts on X.</span></h2>
      <div class="buzz-cycle" data-buzz-cycle>
        {top.map((t, i) => (
          <div class:list={['buzz-slide', { on: i === 0 }]} aria-hidden={i === 0 ? 'false' : 'true'}>
            {t.logo && <img src={t.logo} alt="" width="36" height="36" decoding="async" />}
            <div class="buzz-name">{shortName(t.name)}</div>
            {line(t) && <div class="buzz-meta">{line(t)}</div>}
            <div class="buzz-num">{t.buzz.score}<span>/100</span></div>
            <div class="meter" aria-hidden="true"><i style={`width:${t.buzz.score}%`}></i></div>
          </div>
        ))}
        <div class="buzz-dots" aria-hidden="true">
          {top.map((_, i) => <i class:list={['dot', { on: i === 0 }]}></i>)}
        </div>
      </div>
      <ol class="buzz-list">
        {top.map((t) => (
          <li>
            {t.logo && <img src={t.logo} alt="" width="28" height="28" decoding="async" />}
            <span>
              <span class="buzz-name">{shortName(t.name)}</span>
              {line(t) && <span class="buzz-meta">{line(t)}</span>}
            </span>
            <b>{t.buzz.score}</b>
          </li>
        ))}
      </ol>
    </a>

    <a class="tile tile-creators" href="/creators">
      <h2 class="tc"><b>X creators.</b> <span>A new pass unlocks daily.</span></h2>
      <div class="stat">
        <div class="stat-n">{essentialsLive}</div>
        <i class="stat-rule" aria-hidden="true"></i>
        <div class="stat-l">essentials live</div>
      </div>
    </a>

    <a class="tile tile-drop" href={`/prompts/${issue.slug}`}>
      <h2 class="tc"><b>Prompt Drop.</b> <span>{issue.prompts.length} prompts this week.</span></h2>
      <div class="paper">
        <div class="paper-k">Drop #{issue.n}</div>
        <div class="paper-t">{prompt.title}</div>
        <div class="paper-c">{prompt.category}</div>
      </div>
    </a>

    <div class="tile tile-sub">
      <h2 class="tc"><b>Subscribe on <span class="sub-mark">Substack</span>.</b></h2>
      <p class="sub-line">Sharing ideas on marketing, internet culture, and the next big opportunities worth paying attention to</p>
      <form class="sub-form" data-track="sub:substack" action={SUBSTACK_SUBSCRIBE} method="get" target="_blank" rel="noopener">
        <input class="field" type="email" name="email" placeholder="you@email.com" autocomplete="email" required aria-label="Email" />
        <input type="hidden" name="utm_source" value="toolhype" />
        <input type="hidden" name="utm_medium" value="homepage" />
        <button class="btn sub-go" type="submit">Subscribe</button>
      </form>
    </div>
  </div>
</section>
)}
<style>
.show{container-type:inline-size;margin:0 0 .85rem}
.show-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;align-items:stretch;grid-template-areas:"buzz creators" "drop sub"}
.tile-buzz{grid-area:buzz}
.tile-creators{grid-area:creators}
.tile-drop{grid-area:drop}
.tile-sub{grid-area:sub;container:subtile / inline-size}
.tile{display:flex;flex-direction:column;align-items:stretch;min-width:0;background:var(--surface);border:1px solid var(--line);border-radius:var(--r-card);padding:14px 14px 12px;color:inherit;text-decoration:none;transition:border-color .18s var(--ease),box-shadow .18s var(--ease)}
.tile:hover{color:inherit;border-color:var(--line-strong);box-shadow:0 10px 24px color-mix(in srgb,var(--ink) 6%,transparent)}
.show a:focus-visible,.sub-go:focus-visible{outline:2px solid var(--cyan);outline-offset:3px}
.tc{margin:0;font:400 1rem/1.3 var(--sans);letter-spacing:0;color:var(--ink)}
.tc b{font-family:var(--display);font-weight:650;letter-spacing:-.02em}
.tc span{color:var(--ink-2);font-weight:400}

.buzz-cycle{display:grid;margin-top:10px}
.buzz-slide{grid-area:1/1;display:grid;grid-template-columns:36px minmax(0,1fr) auto;grid-template-areas:"logo name score" "logo meta score" "meter meter meter";column-gap:10px;row-gap:2px;align-items:center;min-width:0;opacity:0;transform:translateY(6px);pointer-events:none}
.buzz-slide.on{opacity:1;transform:none;pointer-events:auto}
.buzz-slide img,.buzz-list img{background:#fff;border:1px solid var(--line);object-fit:contain;box-sizing:border-box}
.buzz-slide img{grid-area:logo;width:36px;height:36px;border-radius:10px;padding:3px}
.buzz-name{grid-area:name;font:650 1rem/1.2 var(--display);letter-spacing:-.02em}
.buzz-slide .buzz-name{white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.buzz-meta{grid-area:meta;font:500 .72rem/1.3 var(--mono);color:var(--ink-2);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.buzz-num{grid-area:score;justify-self:end;font:800 2.5rem/.9 var(--display);letter-spacing:-.045em;font-variant-numeric:tabular-nums;white-space:nowrap}
.buzz-num span{margin-left:.3rem;font:500 .75rem/1 var(--mono);letter-spacing:0;color:var(--ink-3)}
.meter{grid-area:meter;height:6px;margin-top:6px;border-radius:99px;background:var(--field);overflow:hidden}
.meter i{display:block;height:100%;border-radius:inherit;background:var(--cyan)}
.buzz-dots{grid-area:2/1;display:flex;gap:6px;align-items:center;margin-top:10px;height:6px}
.dot{display:block;width:6px;height:6px;border-radius:99px;background:var(--line-strong)}
.dot.on{width:16px;background:var(--cyan)}

.buzz-list{display:none;list-style:none;margin:8px 0 0;padding:0}
.buzz-list li{display:grid;grid-template-columns:28px minmax(0,1fr) auto;gap:8px;align-items:center;padding:3px 0}
.buzz-list img{width:28px;height:28px;border-radius:8px;padding:2px}
.buzz-list .buzz-name,.buzz-list .buzz-meta{display:block}
.buzz-list .buzz-meta{margin:0;white-space:normal;overflow:visible}
.buzz-list b{font:600 .95rem/1 var(--mono);font-variant-numeric:tabular-nums;color:var(--accent-ink)}

.paper{align-self:flex-start;max-width:100%;margin:10px 2px 2px;padding:10px 12px;background:#f4f0e6;color:#1a1a1a;border-radius:3px 10px 10px 10px;box-shadow:0 8px 18px color-mix(in srgb,#000 10%,transparent),0 0 0 1px color-mix(in srgb,#000 5%,transparent);transform:rotate(-1.25deg)}
.paper-k{font:600 .65rem/1 var(--mono);letter-spacing:.12em;text-transform:uppercase;color:#00749e}
.paper-t{margin-top:4px;font:650 .9rem/1.3 var(--display);letter-spacing:-.02em;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.paper-c{margin-top:6px;font:500 .72rem/1.3 var(--mono);color:#616161}
:global([data-theme="dark"]) .paper{box-shadow:0 12px 24px rgba(0,0,0,.45),0 0 0 1px rgba(255,255,255,.08)}

.tc b .sub-mark{color:#ff6719;font-weight:650}
.sub-line{margin:.2rem 0 0;color:var(--ink-2);font:400 1rem/1.3 var(--sans);text-wrap:pretty}
.sub-form{display:flex;gap:8px;align-items:center;margin-top:8px}
.sub-form .field{width:auto;flex:1;min-width:0;margin:0;font-size:1rem}
.sub-go{flex:none;background:#ff6719;border-color:#ff6719;color:#141414;font-weight:650}
.sub-go:hover{background:#e85d10;border-color:#e85d10;color:#141414}
@container subtile (max-width:250px){
  .sub-form{flex-direction:column;align-items:stretch}
  .sub-go{justify-content:center}
}
.stat{margin-top:8px}
.stat-n{font:800 3.15rem/.85 var(--display);letter-spacing:-.045em;font-variant-numeric:tabular-nums}
.stat-rule{display:block;width:1.75rem;height:3px;margin:6px 0 4px;border-radius:99px;background:var(--cyan);transform-origin:left center}
.stat-l{font:500 .75rem/1.3 var(--mono);color:var(--ink-2)}

@media (prefers-reduced-motion:no-preference){
  .buzz-slide{transition:opacity .4s cubic-bezier(.25,.8,.25,1),transform .4s cubic-bezier(.25,.8,.25,1)}
  .dot{transition:width .35s cubic-bezier(.25,.8,.25,1),background .35s linear}
  .paper{animation:th-paper .8s cubic-bezier(.25,.8,.25,1) .12s both}
  .stat-rule{animation:th-line .45s cubic-bezier(.25,.8,.25,1) .24s both}
}
@keyframes th-line{from{transform:scaleX(0)}}
@keyframes th-paper{from{transform:rotate(-4.5deg) translateY(6px)}to{transform:rotate(-1.25deg)}}
@media (prefers-reduced-motion:reduce){
  .buzz-cycle{display:none}
  .buzz-list{display:grid}
  .show-grid{grid-template-areas:"buzz buzz" "drop creators" "sub sub"}
  .paper{animation:none;transform:rotate(-1.25deg)}
  .stat-rule{animation:none;transform:none}
  .tile{transition:border-color .15s var(--ease)}
}
@container (max-width:520px){
  .show-grid{grid-template-columns:1fr;grid-template-areas:"buzz" "drop" "sub" "creators"}
  .buzz-num{font-size:2.15rem}
}
</style>
<script>
const root = document.querySelector<HTMLElement>('[data-buzz-cycle]');
const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
if (root && !reduce) {
  const slides = [...root.querySelectorAll<HTMLElement>('.buzz-slide')];
  const dots = [...root.querySelectorAll<HTMLElement>('.dot')];
  let i = 0;
  let timer = 0;
  const show = (n: number) => {
    i = (n + slides.length) % slides.length;
    slides.forEach((s, k) => {
      const on = k === i;
      s.classList.toggle('on', on);
      s.setAttribute('aria-hidden', on ? 'false' : 'true');
    });
    dots.forEach((d, k) => d.classList.toggle('on', k === i));
  };
  const stop = () => { if (timer) window.clearInterval(timer); timer = 0; };
  const start = () => { stop(); if (slides.length > 1) timer = window.setInterval(() => show(i + 1), 3200); };
  const tile = root.closest('.tile-buzz');
  tile?.addEventListener('mouseenter', stop);
  tile?.addEventListener('mouseleave', start);
  tile?.addEventListener('focusin', stop);
  tile?.addEventListener('focusout', start);
  document.addEventListener('visibilitychange', () => { if (document.hidden) stop(); else start(); });
  show(0);
  start();
}
</script>
