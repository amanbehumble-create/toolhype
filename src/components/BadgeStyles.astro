---
// Y2K-futurism creator pass styles (chrome + iridescent blue, glossy plastic). Pure CSS, no images.
---
<style is:global>
.bdg-grid{list-style:none;margin:0;padding:4px 2px;display:grid;grid-template-columns:repeat(auto-fill,minmax(min(100%,200px),1fr));gap:14px}
.bdg-cell{min-width:0;scroll-margin-top:80px}
.bdg{--chrome:linear-gradient(140deg,#f4f8ff 0%,#b9c8e4 18%,#eef4ff 34%,#8ea6cf 52%,#dfe8f8 68%,#a9bde0 84%,#f6f9ff 100%);
  position:relative;display:flex;flex-direction:column;align-items:center;text-align:center;min-width:0;
  background:radial-gradient(120% 60% at 30% 0%,rgba(255,255,255,.18),transparent 60%),linear-gradient(165deg,#0d1a3a 0%,#0a1230 55%,#1b1050 100%);
  color:#e8f0ff;border-radius:18px;padding:14px 12px 10px;border:3px solid transparent;
  background-clip:padding-box;box-shadow:0 0 0 3px #c9d6ee,0 0 0 4px #6d84b3,0 10px 22px rgba(10,20,60,.35),inset 0 1px 0 rgba(255,255,255,.35);
  font-family:"Geist Mono Variable",ui-monospace,monospace;text-decoration:none!important;overflow:hidden;isolation:isolate}
.bdg::before{content:"";position:absolute;inset:0;z-index:-1;border-radius:inherit;pointer-events:none;
  background:conic-gradient(from 210deg at 80% 10%,rgba(120,200,255,.0),rgba(120,200,255,.22),rgba(200,140,255,.18),rgba(120,255,230,.14),rgba(120,200,255,0) 60%);mix-blend-mode:screen}
.bdg::after{content:"";position:absolute;left:8%;right:8%;top:6px;height:32%;border-radius:14px 14px 50% 50%;background:linear-gradient(rgba(255,255,255,.16),rgba(255,255,255,0));pointer-events:none}
.bdg-hole{display:block;width:44px;height:9px;border-radius:9px;background:#05091c;box-shadow:inset 0 1px 2px #000,0 1px 0 rgba(255,255,255,.4);margin:0 auto 8px}
.bdg-top{display:flex;justify-content:space-between;align-items:center;width:100%;gap:6px;font-size:10px;letter-spacing:.08em}
.bdg-logo{font-family:"Funnel Display Variable",sans-serif;font-size:13px;letter-spacing:0;color:#fff}.bdg-logo b{background:var(--chrome);-webkit-background-clip:text;background-clip:text;color:transparent}
.bdg-kind{padding:1px 6px;border-radius:9px;background:var(--chrome);color:#0b1640;font-weight:700;font-size:9px;white-space:nowrap}
.bdg-photo{margin:10px 0 8px;padding:3px;border-radius:14px;background:var(--chrome);box-shadow:0 2px 8px rgba(0,0,0,.4)}
.bdg-photo img{display:block;width:72px;height:72px;border-radius:11px;object-fit:cover;filter:grayscale(1) contrast(1.12) brightness(1.04);background:#1d2a50}
.bdg-name{display:block;font-family:"Funnel Display Variable",sans-serif;font-weight:800;font-size:16px;line-height:1.15;color:#fff;margin:0;overflow-wrap:anywhere}
.bdg-handle{display:block;font-size:11px;color:#9fc3ff;margin:3px 0 0;overflow-wrap:anywhere}.bdg-handle a{color:#9fe0ff}
.bdg-why{display:block;font-family:"Funnel Sans Variable",sans-serif;font-size:12px;line-height:1.4;color:#d5e1fb;margin:8px 0 0}
.bdg-strip{display:flex;align-items:center;gap:8px;width:100%;margin-top:auto;padding-top:10px}
.bdg-strip .bdg-bar{flex:1;min-width:0;height:22px;fill:#dfe8fb;opacity:.85}
.bdg-id{font-size:10px;color:#9fb5dc;white-space:nowrap}
.bdg-new{display:inline-block;vertical-align:middle;font:700 9px/1 ui-monospace,monospace;padding:3px 5px;border-radius:6px;background:linear-gradient(#ff5fa2,#d1206b);color:#fff}
a.bdg-mini{height:100%;transition:transform .15s ease,box-shadow .15s ease}
a.bdg-mini:hover,a.bdg-mini:focus-visible{transform:translateY(-3px) rotate(-.6deg);box-shadow:0 0 0 3px #e3ecff,0 0 0 4px #7fb2ff,0 14px 26px rgba(10,20,60,.45)}
a.bdg-mini:focus-visible{outline:3px solid #ffd84a;outline-offset:3px}
.bdg-cell:target .bdg{box-shadow:0 0 0 3px #ffd84a,0 0 0 5px #7fb2ff}
.bdg-classified .bdg-photo-x{width:78px;height:78px;display:grid;place-items:center;font:800 34px/1 "Funnel Display Variable",sans-serif;color:#0b1640}
.bdg-stamp{display:inline-block;margin:2px 0 6px;padding:3px 10px;border:2px solid #ff5f7e;color:#ff8aa0;font-weight:800;letter-spacing:.18em;font-size:13px;transform:rotate(-6deg);border-radius:4px}
.bdg-classified .drip-cd{font-family:inherit;color:#fff}
/* full badge on a lanyard */
.bdg-hang{display:flex;flex-direction:column;align-items:center;margin:0 auto 1.5rem;max-width:380px;width:100%}
.bdg-lanyard{position:relative;display:flex;flex-direction:column;align-items:center;height:120px}
.bdg-strap{width:34px;height:96px;overflow:hidden;background:linear-gradient(90deg,#3a1a8c,#6b3cf0 40%,#8a63ff 55%,#3a1a8c);border-radius:0 0 4px 4px;box-shadow:inset 0 0 0 1px rgba(255,255,255,.15);display:flex;justify-content:center}
.bdg-strap i{writing-mode:vertical-rl;font:700 9px/1 ui-monospace,monospace;color:rgba(255,255,255,.7);letter-spacing:.2em;font-style:normal;padding-top:6px;white-space:nowrap}
.bdg-clip{width:30px;height:26px;margin-top:-2px;border-radius:4px 4px 10px 10px;background:linear-gradient(90deg,#8d97a8,#f2f5fa 35%,#b8c0cc 55%,#6f7889);box-shadow:0 2px 3px rgba(0,0,0,.35),inset 0 -6px 0 -3px #59606d}
.bdg-full{width:100%;padding:18px 18px 14px;border-radius:24px;margin-top:-6px}
.bdg-full .bdg-top{font-size:11px}.bdg-full .bdg-logo{font-size:17px}
.bdg-full .bdg-photo img{width:160px;height:160px;border-radius:16px}
.bdg-full .bdg-name{font-size:26px}.bdg-full .bdg-handle{font-size:14px}
.bdg-fields{display:grid;grid-template-columns:1fr 1fr;gap:6px;width:100%;margin:12px 0 0;text-align:left}
.bdg-fields div{background:rgba(255,255,255,.06);border:1px solid rgba(170,200,255,.22);border-radius:8px;padding:5px 8px;min-width:0}
.bdg-fields dt{font-size:9px;letter-spacing:.14em;text-transform:uppercase;color:#8fb0e6}
.bdg-fields dd{margin:1px 0 0;font-size:12px;color:#fff;overflow-wrap:anywhere}
.bdg-full .bdg-why{font-size:14px}
.bdg-tools{font:12px "Funnel Sans Variable",sans-serif;margin:6px 0 0;color:#d5e1fb}.bdg-tools a{color:#9fe0ff}
.bdg-full .bdg-strip{padding-top:14px}.bdg-full .bdg-bar{height:34px}
.bdg-qr{width:58px;height:58px;flex:none;border-radius:4px;fill:#0b1640}
@media (prefers-reduced-motion:reduce){a.bdg-mini{transition:none}a.bdg-mini:hover{transform:none}}
@media (max-width:420px){.bdg-full .bdg-photo img{width:128px;height:128px}.bdg-full .bdg-name{font-size:22px}.bdg-full{padding:14px 12px 12px}}
.cr-page{overflow-x:hidden}
</style>
