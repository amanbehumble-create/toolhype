---
import Base from '../../layouts/Base.astro'; import Shell from '../../components/Shell.astro';
import { getCommunities, toolsIn } from '../../lib/data'; import { crumbsLd } from '../../lib/ld';
---
<Base title="Best AI tools by category" description="Hand-picked best AI tools for coding, agents, video, design, marketing, productivity, chat, audio and more, with one-line verdicts and live X buzz." jsonld={[crumbsLd([['Home', '/'], ['Best AI tools', '/best']])]}>
<Shell><article class="card prose"><h1>Best AI tools by category</h1>
<ul>{getCommunities().map((c) => <li><a href={`/best/${c.slug}`}><b>Best AI tools for {c.name.toLowerCase()}</b></a> ({toolsIn(c.slug).length} tools): {c.description}</li>)}</ul>
<p>Or see <a href="/trending">trending AI tools today</a>.</p></article></Shell></Base>
