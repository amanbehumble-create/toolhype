---
import Subscribe from './Subscribe.astro';
import XCard from './XCard.astro';
import { getCommunities, getTools, trendingOnX, BUZZ_AT, hkt, LABEL } from '../lib/data';
import Votes from './Votes.astro';
const { active = '' } = Astro.props;
const featured = getTools().filter((t) => t.featured);
const stripe = import.meta.env.PUBLIC_STRIPE_FEATURED_LINK;
---
<div class="grid">
  <aside class="left"><nav data-track-zone="sidenav">
    <a href="/" class:list={{ on: active === 'home' }}>🏠 Home</a>
    <a href="/new" class:list={{ on: active === 'new' }}>✨ New this week</a>
    <a href="/buzz" class:list={{ on: active === "buzz" }}>🔥 X Buzz Score</a>
    <a href="/prompts" class:list={{ on: active === "prompts" }}>📋 Prompt Drop</a>
    <a href="/grok-bot-agents" class:list={{ on: active === "agents" }}>🤖 Grok Bot agents</a>
    <a href="/newsletter">✉️ Newsletter</a>
    <div class="label">Communities</div>
    {getCommunities().map((c) => <a href={`/c/${c.slug}`} class:list={{ on: active === c.slug }}>c/{c.slug}</a>)}
  </nav></aside>
  <main><slot/><div class="foot-x"><XCard compact place="footer"/></div></main>
  <aside class="right" data-track-zone="sidebar">
    <slot name="about"/>
    <XCard place="sidebar"/>
    <div class="card"><h3>The weekly drop</h3><p style="margin:.4rem 0"><a href="/prompts/issue-1" style="color:var(--accent-ink)">📋 Read Prompt Drop #1 →</a></p>
      <Subscribe label="Subscribe" place="sidebar" /></div>
    <div class="card"><h3>Featured</h3>
      {featured.length ? featured.map((t) => <p><a href={`/tools/${t.slug}`}>{t.name}</a></p>) :
        <p class="muted">This slot is open. Featured spots are clearly labelled and never change ranking.</p>}
      <a class="btn" href={stripe || '/submit'}>Get featured →</a></div>
    <div class="card"><h3>Trending on X</h3>
      <ol class="trend">{trendingOnX(5).map((t, i) => <li><span class="rk">{i + 1}</span>{t.logo && <img src={t.logo} alt={`${t.name} logo`} width="20" height="20" loading="lazy"/>}<a href={`/tools/${t.slug}`}>{t.name}</a><span class:list={['buzz', 'sm', t.buzz.label]}>{t.buzz.label === 'hype' ? '🔥' : ''}{t.buzz.score}</span></li>)}</ol>
      <p class="muted" style="font-size:.75rem;margin:.5rem 0 0">Updated {hkt(BUZZ_AT)} · <a href="/buzz" style="color:var(--accent-ink)">How the score works</a> · <a href="/?sort=buzz" style="color:var(--accent-ink)">All</a></p></div>
  </aside>
</div>
<Votes/>
