---
// Opens Adrian's Substack subscribe page with the email prefilled (no API key client-side). Moved from Beehiiv on 2026-11-03.
export const SUBSCRIBE_URL = 'https://amanbehumble.substack.com/subscribe';
const { label = 'Subscribe', place = 'subscribe' } = Astro.props;
---
<form data-track={`sub:${place}`} action={SUBSCRIBE_URL} method="get" target="_blank" rel="noopener"><input class="field" type="email" name="email" placeholder="you@email.com" required/><button class="btn primary" style="width:100%;justify-content:center;margin-top:.4rem">{label}</button></form>
